{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/outputs/cache/cmake-user/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/outputs/cache/cmake-user/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "windows-debug",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/outputs/cache/cmake-user/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_GENERATOR_TOOLSET": "v145"
      }
    },
    {
      "name": "windows-release",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/outputs/cache/cmake-user/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_GENERATOR_TOOLSET": "v145"
      }
    },
    {
      "name": "mac-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/outputs/cache/cmake-user/mac-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "mac-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/outputs/cache/cmake-user/mac-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-debug", "configurePreset": "linux-debug", "configuration": "Debug" },
    { "name": "linux-release", "configurePreset": "linux-release", "configuration": "Release" },
    { "name": "windows-debug", "configurePreset": "windows-debug", "configuration": "Debug" },
    { "name": "windows-release", "configurePreset": "windows-release", "configuration": "Release" },
    { "name": "mac-debug", "configurePreset": "mac-debug", "configuration": "Debug" },
    { "name": "mac-release", "configurePreset": "mac-release", "configuration": "Release" }
  ]
}
